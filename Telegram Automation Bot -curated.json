    {
      "parameters": {
        "jsCode": "const msg =\n  \"🚧 *Feature Not Available Yet*\\n\\n\" +\n  \"This ordering option is currently under development and will be available soon.\\n\\n\";\n\nreturn [{ json: { msg } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        304,
        640
      ],
      "id": "fdb4563a-d68f-4644-9837-c27fdcb43d90",
      "name": "Code for Not_available",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\nconst cols = [\n  { key: \"ItemName\", label: \"Item\", max: 26, align: \"left\" },\n  { key: \"MinQuantity\", label: \"Qty\", max: 8, align: \"left\" },\n  { key: \"ItemPrice\", label: \"Price\", max: 8, align: \"right\" },\n  { key: \"Today Availability\", label: \"Avail\", max: 7, align: \"center\" },\n];\n\nconst toText = (v) => (v ?? \"\").toString().trim();\n\nconst truncate = (txt, w) => {\n  txt = toText(txt);\n  if (txt.length <= w) return txt;\n  return txt.slice(0, w - 1) + \"…\";\n};\n\nconst pad = (txt, w, align = \"left\") => {\n  txt = toText(txt);\n  if (txt.length > w) txt = truncate(txt, w);\n\n  if (align === \"right\") return txt.padStart(w, \" \");\n  if (align === \"center\") {\n    const left = Math.floor((w - txt.length) / 2);\n    const right = w - txt.length - left;\n    return \" \".repeat(left) + txt + \" \".repeat(right);\n  }\n  return txt.padEnd(w, \" \");\n};\n\n// ✅ compute perfect widths based on label + data (capped by max)\nconst widths = {};\nfor (const c of cols) {\n  const longest = Math.max(\n    c.label.length,\n    ...rows.map(r => toText(r[c.key]).length)\n  );\n  widths[c.key] = Math.min(longest, c.max);\n}\n\nlet msg = \"🛒 TODAY ITEMS\\n\";\nmsg += \"```\\n\";\n\nconst header = cols.map(c => pad(c.label, widths[c.key], \"center\")).join(\" | \");\nconst sep    = cols.map(c => \"-\".repeat(widths[c.key])).join(\"-+-\");\n\nmsg += header + \"\\n\";\nmsg += sep + \"\\n\";\n\nfor (const r of rows) {\n  // optional: nicer price formatting\n  const price = toText(r[\"ItemPrice\"]);\n  const priceTxt = price ? (price.includes(\"₹\") ? price : `₹${price}`) : \"\";\n\n  msg += cols.map(c => {\n    const value =\n      c.key === \"ItemPrice\" ? priceTxt :\n      c.key === \"Today Availability\" ? (toText(r[c.key]) || \"—\") :\n      toText(r[c.key]) || \"—\";\n\n    return pad(value, widths[c.key], c.align);\n  }).join(\" | \") + \"\\n\";\n}\n\nmsg += \"```\";\n\nreturn [{ json: { msg } }];\n"
      },
